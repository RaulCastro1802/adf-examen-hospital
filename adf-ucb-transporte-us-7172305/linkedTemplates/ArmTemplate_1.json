{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "adf-ucb-transporte-us-7172305"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/df_gold_dim_fecha')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "oro"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "sql_silver_admissions",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "sql_gold_dim_fecha",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "derivedColumn"
						}
					],
					"scriptLines": [
						"source(output(",
						"          fecha_completa as date,",
						"          anio as integer,",
						"          trimestre as integer,",
						"          mes as integer,",
						"          semana_anio as integer,",
						"          dia_mes as integer,",
						"          dia_semana as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT c.d AS fecha_completa, YEAR(c.d) AS anio, DATEPART(QUARTER, c.d) AS trimestre, MONTH(c.d) AS mes, DATEPART(ISO_WEEK, c.d) AS semana_anio, DAY(c.d) AS dia_mes, ((DATEDIFF(DAY, DATEFROMPARTS(1900,1,1), c.d) % 7) + 1) AS dia_semana FROM (SELECT DATEADD(DAY, t.n, r.ini) AS d FROM (SELECT DATEFROMPARTS(YEAR(MIN(u.d)), 1, 1) AS ini, DATEFROMPARTS(YEAR(MAX(u.d)), 12, 31) AS fin FROM (SELECT admission_date AS d FROM silver.admissions UNION ALL SELECT discharge_date FROM silver.admissions UNION ALL SELECT payment_date FROM silver.billing) u) r CROSS APPLY (SELECT TOP (DATEDIFF(DAY, r.ini, r.fin) + 1) ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) - 1 AS n FROM sys.all_objects a CROSS JOIN sys.all_objects b) t) c',",
						"     format: 'query') ~> source1",
						"source1 derive(fecha_key = toInteger(toString(fecha_completa,'yyyyMMdd')),",
						"          trimestre_nombre = concat('T',toString(trimestre)),",
						"          mes_nombre = case(mes==1,'Enero', mes==2,'Febrero', mes==3,'Marzo', mes==4,'Abril', mes==5,'Mayo', mes==6,'Junio', mes==7,'Julio', mes==8,'Agosto', mes==9,'Septiembre', mes==10,'Octubre', mes==11,'Noviembre', 'Diciembre'),",
						"          mes_corto = case(mes==1,'Ene', mes==2,'Feb', mes==3,'Mar', mes==4,'Abr', mes==5,'May', mes==6,'Jun', mes==7,'Jul', mes==8,'Ago', mes==9,'Sep', mes==10,'Oct', mes==11,'Nov', 'Dic'),",
						"          dia_nombre = case(dia_semana==1,'Lunes', dia_semana==2,'Martes', dia_semana==3,'Miércoles', dia_semana==4,'Jueves', dia_semana==5,'Viernes', dia_semana==6,'Sábado', 'Domingo'),",
						"          es_fin_de_semana = dia_semana>=6) ~> derivedColumn",
						"derivedColumn sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          fecha_key as integer,",
						"          fecha_completa as date,",
						"          anio as integer,",
						"          trimestre as integer,",
						"          trimestre_nombre as string,",
						"          mes as integer,",
						"          mes_nombre as string,",
						"          mes_corto as string,",
						"          semana_anio as integer,",
						"          dia_mes as integer,",
						"          dia_semana as integer,",
						"          dia_nombre as string,",
						"          es_fin_de_semana as boolean",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
