{
	"name": "df_silver_patients",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sql_bronze_patients",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sql_silver_patients",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "Filter1"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          patient_id as string,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as string,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(raw_id = patient_id,",
				"          raw_dob = trim(date_of_birth),",
				"          pid = toInteger(trim(patient_id)),",
				"          full_name = trim(regexReplace(full_name,'[^ -~]','')),",
				"          gender_c = case(upper(left(trim(gender),1))=='M','Male', upper(left(trim(gender),1))=='F','Female', toString(null())),",
				"          date_of_birth = trim(date_of_birth),",
				"          phone_digits = regexReplace(phone,'[^0-9]',''),",
				"          email_e = regexReplace(regexReplace(regexReplace(lower(trim(email)),' at ','@'),',','.'),'gmial','gmail'),",
				"          ins_key = lower(regexReplace(trim(insurance_provider),'[ .-]','')),",
				"          address = iif(trim(address)=='', toString(null()), trim(address))) ~> derivedColumn1",
				"derivedColumn1 derive(dob_iso = case(regexMatch(date_of_birth,'[0-9]{4}-[0-9]{2}-[0-9]{2}'), date_of_birth, regexMatch(date_of_birth,'[0-9]{2}/[0-9]{2}/[0-9]{4}'), concat(substring(date_of_birth,7,4),'-',substring(date_of_birth,1,2),'-',substring(date_of_birth,4,2)), regexMatch(date_of_birth,'[0-9]{2}-[0-9]{2}-[0-9]{2}'), concat(iif(toInteger(substring(date_of_birth,7,2))<=26,'20','19'),substring(date_of_birth,7,2),'-',substring(date_of_birth,1,2),'-',substring(date_of_birth,4,2)), regexMatch(date_of_birth,'[0-9]{2}-[A-Za-z]{3}-[0-9]{4}'), concat(substring(date_of_birth,8,4),'-',lpad(toString(toInteger((locate(lower(substring(date_of_birth,4,3)),'janfebmaraprmayjunjulaugsepoctnovdec')+2)/3)),2,'0'),'-',substring(date_of_birth,1,2)), regexMatch(date_of_birth,'[A-Za-z]+ [0-9]{1,2}, [0-9]{4}'), concat(right(date_of_birth,4),'-',lpad(toString(toInteger((locate(lower(substring(date_of_birth,1,3)),'janfebmaraprmayjunjulaugsepoctnovdec')+2)/3)),2,'0'),'-',lpad(regexReplace(split(date_of_birth,' ')[2],',',''),2,'0')), toString(null())),",
				"          phone_c = case(length(phone_digits)==11 && left(phone_digits,1)=='1', substring(phone_digits,2,10), length(phone_digits)==10, phone_digits, toString(null())),",
				"          email_c = iif(regexMatch(email_e,'[^@ ]+@[^@ ]+[.][a-z]+'), email_e, toString(null())),",
				"          insurance_c = case(isNull(ins_key)||ins_key=='', toString(null()), startsWith(ins_key,'aetna'),'Aetna', startsWith(ins_key,'bluecross'),'Blue Cross', startsWith(ins_key,'cigna'),'Cigna', ins_key=='medicaid','Medicaid', ins_key=='medicare','Medicare', ins_key=='selfpay','Self-Pay', ins_key=='unitedhealth'||ins_key=='uhc','UnitedHealth', trim(insurance_provider))) ~> derivedColumn2",
				"derivedColumn2 derive(reject_reason = case(isNull(pid),'patient_id invalido', isNull(full_name)||full_name=='','full_name vacio', toString(null()))) ~> derivedColumn3",
				"derivedColumn3 filter(isNull(reject_reason)) ~> Filter1",
				"Filter1 select(mapColumn(",
				"          patient_id = pid,",
				"          full_name,",
				"          gender = gender_c,",
				"          date_of_birth = raw_dob,",
				"          phone = phone_c,",
				"          email = email_c,",
				"          address,",
				"          insurance_provider = insurance_c",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          patient_id as integer,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as date,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          patient_id,",
				"          full_name,",
				"          gender,",
				"          date_of_birth,",
				"          phone,",
				"          email,",
				"          address,",
				"          insurance_provider",
				"     ),",
				"     store: 'sqlserver',",
				"     schemaName: 'silver') ~> sink1"
			]
		}
	}
}