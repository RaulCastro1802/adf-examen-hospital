{
	"name": "df_silver_admissions",
	"properties": {
		"folder": {
			"name": "plata"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sql_bronze_admissions",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "sql_silver_patients",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sql_silver_admissions",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select2"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "lookup1"
				},
				{
					"name": "derivedColumn4"
				},
				{
					"name": "derivedColumn5"
				},
				{
					"name": "filter1"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          admission_id as string,",
				"          patient_id as string,",
				"          admission_date as string,",
				"          discharge_date as string,",
				"          department as string,",
				"          attending_doctor_id as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          patient_id as integer,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as date,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source2 select(mapColumn(",
				"          pat_ref = patient_id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"source1 derive(raw_id = admission_id,",
				"          aid = toInteger(trim(admission_id)),",
				"          pid_old = toInteger(trim(patient_id)),",
				"          doctor_id = toInteger(trim(attending_doctor_id)),",
				"          raw_discharge = trim(discharge_date),",
				"          admission_date = trim(admission_date),",
				"          discharge_date = trim(discharge_date),",
				"          dept_key = lower(replace(trim(department),' ',''))) ~> derivedColumn1",
				"derivedColumn1 derive(adm_iso = case(regexMatch(admission_date,'[0-9]{4}-[0-9]{2}-[0-9]{2}'), admission_date, regexMatch(admission_date,'[0-9]{2}/[0-9]{2}/[0-9]{4}'), concat(substring(admission_date,7,4),'-',substring(admission_date,1,2),'-',substring(admission_date,4,2)), regexMatch(admission_date,'[0-9]{2}-[0-9]{2}-[0-9]{2}'), concat(iif(toInteger(substring(admission_date,7,2))<=26,'20','19'),substring(admission_date,7,2),'-',substring(admission_date,1,2),'-',substring(admission_date,4,2)), regexMatch(admission_date,'[0-9]{2}-[A-Za-z]{3}-[0-9]{4}'), concat(substring(admission_date,8,4),'-',lpad(toString(toInteger((locate(lower(substring(admission_date,4,3)),'janfebmaraprmayjunjulaugsepoctnovdec')+2)/3)),2,'0'),'-',substring(admission_date,1,2)), regexMatch(admission_date,'[A-Za-z]+ [0-9]{1,2}, [0-9]{4}'), concat(right(admission_date,4),'-',lpad(toString(toInteger((locate(lower(substring(admission_date,1,3)),'janfebmaraprmayjunjulaugsepoctnovdec')+2)/3)),2,'0'),'-',lpad(regexReplace(split(admission_date,' ')[2],',',''),2,'0')), toString(null())),",
				"          dis_iso = case(regexMatch(discharge_date,'[0-9]{4}-[0-9]{2}-[0-9]{2}'), discharge_date, regexMatch(discharge_date,'[0-9]{2}/[0-9]{2}/[0-9]{4}'), concat(substring(discharge_date,7,4),'-',substring(discharge_date,1,2),'-',substring(discharge_date,4,2)), regexMatch(discharge_date,'[0-9]{2}-[0-9]{2}-[0-9]{2}'), concat(iif(toInteger(substring(discharge_date,7,2))<=26,'20','19'),substring(discharge_date,7,2),'-',substring(discharge_date,1,2),'-',substring(discharge_date,4,2)), regexMatch(discharge_date,'[0-9]{2}-[A-Za-z]{3}-[0-9]{4}'), concat(substring(discharge_date,8,4),'-',lpad(toString(toInteger((locate(lower(substring(discharge_date,4,3)),'janfebmaraprmayjunjulaugsepoctnovdec')+2)/3)),2,'0'),'-',substring(discharge_date,1,2)), regexMatch(discharge_date,'[A-Za-z]+ [0-9]{1,2}, [0-9]{4}'), concat(right(discharge_date,4),'-',lpad(toString(toInteger((locate(lower(substring(discharge_date,1,3)),'janfebmaraprmayjunjulaugsepoctnovdec')+2)/3)),2,'0'),'-',lpad(regexReplace(split(discharge_date,' ')[2],',',''),2,'0')), toString(null()))) ~> derivedColumn2",
				"derivedColumn2 derive(adm_ok = iif(toString(toDate(adm_iso,'yyyy-MM-dd'),'yyyy-MM-dd')==adm_iso, adm_iso, toString(null())),",
				"          dis_ok = iif(toString(toDate(dis_iso,'yyyy-MM-dd'),'yyyy-MM-dd')==dis_iso, dis_iso, toString(null()))) ~> derivedColumn3",
				"derivedColumn3, select2 lookup(pid_old == pat_ref,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup1",
				"lookup1 derive(discharge_s = iif(dis_ok>=adm_ok && dis_ok<=toString(currentDate(),'yyyy-MM-dd'), dis_ok, toString(null())),",
				"          dept_name = case(dept_key=='er' || startsWith(dept_key,'emerg'),'Emergency', startsWith(dept_key,'card'),'Cardiology', startsWith(dept_key,'gen'),'General Surgery', startsWith(dept_key,'neuro') || startsWith(dept_key,'nuero'),'Neurology', startsWith(dept_key,'onco'),'Oncology', startsWith(dept_key,'ortho'),'Orthopedics', startsWith(dept_key,'ped') || startsWith(dept_key,'paed'),'Pediatrics', toString(null()))) ~> derivedColumn4",
				"derivedColumn4 derive(adm_d = toDate(adm_ok,'yyyy-MM-dd'),",
				"          discharge_ok = toDate(discharge_s,'yyyy-MM-dd'),",
				"          reject_reason = case(isNull(aid),'admission_id invalido', isNull(adm_ok),'admission_date nula o ilegible', adm_ok<'2000-01-01' || adm_ok>toString(currentDate(),'yyyy-MM-dd'),'admission_date fuera de rango', isNull(pat_ref),'paciente inexistente (huerfana)', isNull(dept_name),'departamento sin mapeo', isNull(doctor_id),'doctor nulo', toString(null()))) ~> derivedColumn5",
				"derivedColumn5 filter(isNull(reject_reason)) ~> filter1",
				"filter1 select(mapColumn(",
				"          admission_id = aid,",
				"          patient_id = pid_old,",
				"          admission_date = adm_d,",
				"          discharge_date = discharge_ok,",
				"          department = dept_name,",
				"          attending_doctor_id = doctor_id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          admission_id,",
				"          patient_id,",
				"          admission_date,",
				"          discharge_date,",
				"          department,",
				"          attending_doctor_id",
				"     ),",
				"     store: 'sqlserver',",
				"     schemaName: 'silver') ~> sink1"
			]
		}
	}
}