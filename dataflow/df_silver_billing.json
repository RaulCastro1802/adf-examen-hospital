{
	"name": "df_silver_billing",
	"properties": {
		"folder": {
			"name": "plata"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sql_bronze_billing",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "sql_silver_admissions",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sql_silver_billing",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "DerivedColumn4"
				},
				{
					"name": "lookup1"
				},
				{
					"name": "derivedColumn5"
				},
				{
					"name": "Filter1"
				},
				{
					"name": "select2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          billing_id as string,",
				"          admission_id as string,",
				"          charge_type as string,",
				"          amount as string,",
				"          payment_status as string,",
				"          payment_date as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source2 select(mapColumn(",
				"          adm_ref = admission_id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"source1 derive(raw_id = billing_id,",
				"          bid = toInteger(trim(billing_id)),",
				"          aid = toInteger(trim(admission_id)),",
				"          charge = iif(isNull(trim(charge_type)) || trim(charge_type)=='', 'Unknown', trim(charge_type)),",
				"          amt_s = regexReplace(upper(trim(amount)),'[^0-9.-]',''),",
				"          status = case(lower(trim(payment_status))=='paid','Paid', lower(trim(payment_status))=='pending','Pending', lower(trim(payment_status))=='unpaid','Unpaid', lower(trim(payment_status))=='overdue','Overdue', toString(null())),",
				"          raw_payment = trim(payment_date),",
				"          payment_date = trim(payment_date)) ~> derivedColumn1",
				"derivedColumn1 derive(amt = toDouble(iif(isNull(amt_s) || amt_s=='', toString(null()), amt_s)),",
				"          pay_iso = case(regexMatch(payment_date,'[0-9]{4}-[0-9]{2}-[0-9]{2}'), payment_date, regexMatch(payment_date,'[0-9]{2}/[0-9]{2}/[0-9]{4}'), concat(substring(payment_date,7,4),'-',substring(payment_date,1,2),'-',substring(payment_date,4,2)), regexMatch(payment_date,'[0-9]{2}-[0-9]{2}-[0-9]{2}'), concat(iif(toInteger(substring(payment_date,7,2))<=26,'20','19'),substring(payment_date,7,2),'-',substring(payment_date,1,2),'-',substring(payment_date,4,2)), regexMatch(payment_date,'[0-9]{2}-[A-Za-z]{3}-[0-9]{4}'), concat(substring(payment_date,8,4),'-',lpad(toString(toInteger((locate(lower(substring(payment_date,4,3)),'janfebmaraprmayjunjulaugsepoctnovdec')+2)/3)),2,'0'),'-',substring(payment_date,1,2)), regexMatch(payment_date,'[A-Za-z]+ [0-9]{1,2}, [0-9]{4}'), concat(right(payment_date,4),'-',lpad(toString(toInteger((locate(lower(substring(payment_date,1,3)),'janfebmaraprmayjunjulaugsepoctnovdec')+2)/3)),2,'0'),'-',lpad(regexReplace(split(payment_date,' ')[2],',',''),2,'0')), toString(null()))) ~> derivedColumn2",
				"derivedColumn2 derive(pay_ok = iif(toString(toDate(pay_iso,'yyyy-MM-dd'),'yyyy-MM-dd')==pay_iso, pay_iso, toString(null())),",
				"          amount_r = toDecimal(round(amt,2),12,2)) ~> derivedColumn3",
				"derivedColumn3 derive(pay_s = iif(pay_ok>='2000-01-01' && pay_ok<=toString(currentDate(),'yyyy-MM-dd'), pay_ok, toString(null()))) ~> DerivedColumn4",
				"DerivedColumn4, select1 lookup(aid == adm_ref,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup1",
				"lookup1 derive(payment_ok = toDate(pay_s,'yyyy-MM-dd'),",
				"          reject_reason = case(isNull(bid),'billing_id invalido', isNull(amt),'amount nulo o ilegible', abs(amt)>=1000000000,'amount fuera de rango', isNull(status),'payment_status desconocido', isNull(adm_ref),'admision inexistente (huerfana)', toString(null()))) ~> derivedColumn5",
				"derivedColumn5 filter(isNull(reject_reason)) ~> Filter1",
				"Filter1 select(mapColumn(",
				"          billing_id = bid,",
				"          admission_id = aid,",
				"          charge_type = charge,",
				"          amount = amount_r,",
				"          payment_status = status,",
				"          payment_date = payment_ok",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          billing_id as integer,",
				"          admission_id as integer,",
				"          charge_type as string,",
				"          amount as decimal(12,2),",
				"          payment_status as string,",
				"          payment_date as date",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          billing_id,",
				"          admission_id,",
				"          charge_type,",
				"          amount,",
				"          payment_status,",
				"          payment_date",
				"     ),",
				"     store: 'sqlserver',",
				"     schemaName: 'silver') ~> sink1"
			]
		}
	}
}