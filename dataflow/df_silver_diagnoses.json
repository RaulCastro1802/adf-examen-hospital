{
	"name": "df_silver_diagnoses",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sql_bronze_diagnoses",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "sql_silver_admissions",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sql_silver_diagnoses",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "selAdmRef"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "Flatten1"
				},
				{
					"name": "Filter1"
				},
				{
					"name": "DerivedColumn2"
				},
				{
					"name": "DerivedColumn3"
				},
				{
					"name": "lkpAdm"
				},
				{
					"name": "rulesDx"
				},
				{
					"name": "validDx"
				},
				{
					"name": "dedupDx"
				},
				{
					"name": "rankDx"
				},
				{
					"name": "idDx"
				},
				{
					"name": "selDx"
				}
			],
			"scriptLines": [
				"source(output(",
				"          diagnosis_id as string,",
				"          admission_id as string,",
				"          icd_code as string,",
				"          diagnosis_description as string,",
				"          severity as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source2 select(mapColumn(",
				"          adm_ref = admission_id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selAdmRef",
				"source1 derive(raw_id = diagnosis_id,",
				"          did = toInteger(trim(diagnosis_id)),",
				"          aid = toInteger(trim(admission_id)),",
				"          codes = split(coalesce(icd_code,''),','),",
				"          dx_desc = iif(trim(diagnosis_description)=='', toString(null()), trim(diagnosis_description)),",
				"          sev = case(lower(trim(severity))=='mild','Mild', lower(trim(severity))=='moderate','Moderate', lower(trim(severity))=='severe','Severe', lower(trim(severity))=='critical','Critical', toString(null()))) ~> derivedColumn1",
				"derivedColumn1 foldDown(unroll(codes),",
				"     mapColumn(",
				"          raw_id,",
				"          did,",
				"          aid,",
				"          sev,",
				"          dx_desc,",
				"          raw_code = codes",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> Flatten1",
				"Flatten1 filter(trim(raw_code)!='') ~> Filter1",
				"Filter1 derive(n = upper(regexReplace(trim(raw_code),'[ .-]',''))) ~> DerivedColumn2",
				"DerivedColumn2 derive(icd = iif(length(n)>3, concat(substring(n,1,3),'.',substring(n,4,10)), n)) ~> DerivedColumn3",
				"DerivedColumn3, selAdmRef lookup(aid == adm_ref,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lkpAdm",
				"lkpAdm derive(reject_reason = case(isNull(did),'diagnosis_id invalido', isNull(adm_ref),'admision inexistente (huerfano)', !regexMatch(icd,'[A-Z][0-9]{2}([.][0-9A-Z]{1,4})?'),'icd con formato invalido', toString(null())),",
				"          icd_desc = case(icd=='C50.911','Malignant neoplasm of unspecified site of right female breast', icd=='E11.9','Type 2 diabetes mellitus without complications', icd=='F32.9','Major depressive disorder, single episode, unspecified', icd=='I10','Essential (primary) hypertension', icd=='J45.909','Unspecified asthma, uncomplicated', icd=='K21.9','Gastro-esophageal reflux disease without esophagitis', icd=='M54.5','Low back pain', icd=='N39.0','Urinary tract infection, site not specified', icd=='R51','Headache', icd=='S72.001A','Fracture of unspecified part of neck of right femur, initial encounter', dx_desc)) ~> rulesDx",
				"rulesDx filter(isNull(reject_reason)) ~> validDx",
				"validDx aggregate(groupBy(did,",
				"          icd),",
				"     aid = first(aid),",
				"          icd_desc = first(icd_desc),",
				"          sev = first(sev)) ~> dedupDx",
				"dedupDx window(over(did),",
				"     asc(icd, true),",
				"     n_code = rowNumber()) ~> rankDx",
				"rankDx derive(new_did = toInteger(did + 100000*(n_code-1))) ~> idDx",
				"idDx select(mapColumn(",
				"          diagnosis_id = new_did,",
				"          admission_id = aid,",
				"          icd_code = icd,",
				"          diagnosis_description = icd_desc,",
				"          severity = sev",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selDx",
				"selDx sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          diagnosis_id as integer,",
				"          admission_id as integer,",
				"          icd_code as string,",
				"          diagnosis_description as string,",
				"          severity as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          diagnosis_id,",
				"          admission_id,",
				"          icd_code,",
				"          diagnosis_description,",
				"          severity",
				"     ),",
				"     store: 'sqlserver',",
				"     schemaName: 'silver') ~> sink1"
			]
		}
	}
}